<UserControl x:Class="K7Titan.App.Views.ScanPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="0,0,0,14">
            <TextBlock Text="Scan" FontSize="26" FontWeight="SemiBold"/>
            <TextBlock Text="Scan a folder, drive or file for threats" Opacity="0.6" Margin="0,2,0,0"/>
        </StackPanel>

        <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,0,0,10">
            <ui:TextBox x:Name="PathBox" Width="560" PlaceholderText="C:\path\to\scan" Text="C:\Windows\Temp"/>
            <ui:Button x:Name="BrowseButton" Content="Browse" Icon="{ui:SymbolIcon FolderOpen24}"
                       Margin="8,0,0,0" Click="OnBrowse"/>
            <ui:Button x:Name="ScanButton" Content="Scan" Icon="{ui:SymbolIcon Search24}"
                       Appearance="Primary" Margin="8,0,0,0" Click="OnScan"/>
            <ui:Button x:Name="CancelButton" Content="Cancel" Icon="{ui:SymbolIcon Stop24}"
                       Margin="8,0,0,0" IsEnabled="False" Click="OnCancel"/>
        </StackPanel>

        <StackPanel Grid.Row="2" Margin="0,0,0,10">
            <StackPanel Orientation="Horizontal">
                <ui:ProgressRing x:Name="Progress" IsIndeterminate="True" Width="22" Height="22"
                                 Visibility="Collapsed" Margin="0,0,8,0"/>
                <TextBlock x:Name="StatusText" Text="Idle" VerticalAlignment="Center" Opacity="0.75"/>
            </StackPanel>
            <TextBlock x:Name="StatsText" Text="" FontSize="12" Opacity="0.6" Margin="0,6,0,0"/>
        </StackPanel>

        <DataGrid Grid.Row="3" x:Name="ResultsGrid" AutoGenerateColumns="False" IsReadOnly="True"
                  HeadersVisibility="Column" GridLinesVisibility="None">
            <DataGrid.Columns>
                <DataGridTextColumn Header="File" Binding="{Binding FilePath}" Width="2*"/>
                <DataGridTextColumn Header="Level" Binding="{Binding Level}" Width="90"/>
                <DataGridTextColumn Header="Threat" Binding="{Binding ThreatName}" Width="*"/>
                <DataGridTextColumn Header="Layer" Binding="{Binding Layer}" Width="90"/>
                <DataGridTextColumn Header="Score" Binding="{Binding Score}" Width="70"/>
            </DataGrid.Columns>
        </DataGrid>

        <StackPanel Grid.Row="4" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,10,0,0">
            <ui:Button x:Name="ExportButton" Content="Export report" Icon="{ui:SymbolIcon DocumentSave24}"
                       Click="OnExport"/>
            <ui:Button x:Name="QuarantineButton" Content="Quarantine threats" Icon="{ui:SymbolIcon ShieldError24}"
                       Appearance="Danger" Margin="8,0,0,0" Click="OnQuarantine"/>
        </StackPanel>
    </Grid>
</UserControl>
