<UserControl x:Class="K7Titan.App.Views.DashboardPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel>
            <TextBlock Text="Dashboard" FontSize="26" FontWeight="SemiBold"/>
            <TextBlock x:Name="Subtitle" Text="Protection overview" Opacity="0.6" Margin="0,2,0,18"/>

            <Border Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1" CornerRadius="10" Padding="20">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0">
                        <TextBlock x:Name="ProtectionStatus" Text="You are protected" FontSize="20" FontWeight="SemiBold"/>
                        <TextBlock x:Name="ProtectionDetail" Text="Real-time protection is off" Opacity="0.65" Margin="0,4,0,0"/>
                    </StackPanel>
                    <ui:Button Grid.Column="1" x:Name="RealtimeButton" Content="Enable real-time"
                               Icon="{ui:SymbolIcon ShieldCheckmark24}" Appearance="Primary"
                               VerticalAlignment="Center" Click="OnToggleRealtime"/>
                </Grid>
            </Border>

            <UniformGrid Columns="4" Margin="0,12,0,0">
                <Border Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
                        BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                        BorderThickness="1" CornerRadius="10" Padding="16" Margin="0,0,6,0">
                    <StackPanel>
                        <TextBlock Text="Engine" Opacity="0.6" FontSize="12"/>
                        <TextBlock x:Name="EngineValue" Text="-" FontSize="20" FontWeight="SemiBold" Margin="0,6,0,0"/>
                    </StackPanel>
                </Border>
                <Border Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
                        BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                        BorderThickness="1" CornerRadius="10" Padding="16" Margin="6,0,6,0">
                    <StackPanel>
                        <TextBlock Text="Quarantined" Opacity="0.6" FontSize="12"/>
                        <TextBlock x:Name="QuarantineValue" Text="0" FontSize="20" FontWeight="SemiBold" Margin="0,6,0,0"/>
                    </StackPanel>
                </Border>
                <Border Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
                        BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                        BorderThickness="1" CornerRadius="10" Padding="16" Margin="6,0,6,0">
                    <StackPanel>
                        <TextBlock Text="Activity events" Opacity="0.6" FontSize="12"/>
                        <TextBlock x:Name="LogValue" Text="0" FontSize="20" FontWeight="SemiBold" Margin="0,6,0,0"/>
                    </StackPanel>
                </Border>
                <Border Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
                        BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                        BorderThickness="1" CornerRadius="10" Padding="16" Margin="6,0,0,0">
                    <StackPanel>
                        <TextBlock Text="Exclusions" Opacity="0.6" FontSize="12"/>
                        <TextBlock x:Name="ExclusionValue" Text="0" FontSize="20" FontWeight="SemiBold" Margin="0,6,0,0"/>
                    </StackPanel>
                </Border>
            </UniformGrid>

            <Border Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1" CornerRadius="10" Padding="20" Margin="0,12,0,0">
                <StackPanel>
                    <TextBlock Text="Detection layers" FontSize="16" FontWeight="SemiBold" Margin="0,0,0,10"/>
                    <TextBlock Text="Signature (SHA-256) — exact hash match against the threat database"/>
                    <TextBlock Text="YARA — pattern rules for known families and malicious scripts" Margin="0,4,0,0"/>
                    <TextBlock Text="Heuristics — Shannon entropy and suspicious structure scoring" Margin="0,4,0,0"/>
                    <TextBlock Text="Behaviour — real-time watcher flags files the moment they appear" Margin="0,4,0,0"/>
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
