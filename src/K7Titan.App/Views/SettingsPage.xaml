<UserControl x:Class="K7Titan.App.Views.SettingsPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel>
            <TextBlock Text="Settings" FontSize="26" FontWeight="SemiBold" Margin="0,0,0,14"/>

            <Border Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1" CornerRadius="10" Padding="20">
                <StackPanel>
                    <TextBlock Text="Scanning" FontSize="16" FontWeight="SemiBold" Margin="0,0,0,10"/>
                    <ui:ToggleSwitch x:Name="LowConfidenceToggle" Content="Treat low-confidence heuristics as threats"
                                     Margin="0,0,0,8"/>
                    <ui:ToggleSwitch x:Name="ArchiveToggle" Content="Scan inside archives" Margin="0,0,0,8"/>
                    <TextBlock Text="Maximum file size (MB)" Margin="0,4,0,4"/>
                    <ui:NumberBox x:Name="MaxSizeBox" Value="64" MaxWidth="200" HorizontalAlignment="Left"/>
                </StackPanel>
            </Border>

            <Border Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1" CornerRadius="10" Padding="20" Margin="0,12,0,0">
                <StackPanel>
                    <TextBlock Text="Real-time protection" FontSize="16" FontWeight="SemiBold" Margin="0,0,0,10"/>
                    <ui:ToggleSwitch x:Name="RealtimeToggle" Content="Enable real-time monitoring"/>
                </StackPanel>
            </Border>

            <Border Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1" CornerRadius="10" Padding="20" Margin="0,12,0,0">
                <StackPanel>
                    <TextBlock Text="Exclusions" FontSize="16" FontWeight="SemiBold" Margin="0,0,0,10"/>
                    <TextBlock x:Name="ExclusionSummary" Opacity="0.7"/>
                </StackPanel>
            </Border>

            <Border Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1" CornerRadius="10" Padding="20" Margin="0,12,0,0">
                <StackPanel>
                    <TextBlock Text="About" FontSize="16" FontWeight="SemiBold" Margin="0,0,0,10"/>
                    <TextBlock x:Name="AboutText" Opacity="0.7" TextWrapping="Wrap"/>
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
